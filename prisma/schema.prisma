generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String?
  email     String?  @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([clerkId])
  @@index([email])
}

model Event {
  id            String   @id @default(cuid())
  hostId        String
  host          User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title         String
  slug          String   @unique
  description   String?
  eventDate     DateTime
  eventTime     String
  location      String
  coverImage    String?
  visibility    String   @default("public")
  theme         String   @default("Mehfil")
  category      String?
  city          String?
  capacity      Int?
  allowPlusOne  Boolean  @default(true)
  requiresApproval Boolean @default(false)
  waitlistEnabled  Boolean @default(true)
  upiId         String?
  paymentNote   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rsvps        RSVP[]
  activities   EventActivity[]
  datePolls    DatePoll[]
  memoryPhotos MemoryPhoto[]
  infoBlocks   EventInfoBlock[]
  rsvpQuestions RsvpQuestion[]
  broadcasts EventBroadcast[]

  @@index([hostId])
  @@index([slug])
  @@index([city])
  @@index([category])
}

model RSVP {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  status        RSVPStatus
  approvalStatus ApprovalStatus @default(APPROVED)
  plusOne       Boolean       @default(false)
  note          String?
  paymentStatus PaymentStatus @default(NOT_REQUIRED)
  checkedIn     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  answers RsvpAnswer[]

  @@index([eventId])
  @@index([email])
  @@index([phone])
  @@index([approvalStatus])
}

model EventInfoBlock {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      InfoBlockType @default(TEXT)
  title     String
  content   String
  url       String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([eventId])
  @@index([sortOrder])
}

model EventBroadcast {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  message   String
  audience  BroadcastAudience @default(ALL)
  pinned    Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([eventId])
  @@index([audience])
  @@index([createdAt])
}

model RsvpQuestion {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      RsvpQuestionType @default(TEXT)
  question  String
  options   String[]         @default([])
  required  Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  answers RsvpAnswer[]

  @@index([eventId])
  @@index([sortOrder])
}

model RsvpAnswer {
  id         String       @id @default(cuid())
  rsvpId     String
  rsvp       RSVP         @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  questionId String
  question   RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([rsvpId])
  @@index([questionId])
}

model EventActivity {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model DatePoll {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question  String
  createdAt DateTime @default(now())

  options PollOption[]

  @@index([eventId])
}

model PollOption {
  id         String   @id @default(cuid())
  pollId     String
  poll       DatePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionDate DateTime
  label      String?
  createdAt  DateTime @default(now())

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id         String     @id @default(cuid())
  optionId   String
  option     PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  guestName  String
  guestPhone String?
  createdAt  DateTime   @default(now())

  @@index([optionId])
}

model MemoryPhoto {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl     String
  publicId     String?
  caption      String?
  uploadedBy   String?
  uploaderName String?
  approved     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([approved])
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
}

enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
  WAITLISTED
}

enum InfoBlockType {
  TEXT
  LINK
  FAQ
  NOTE
}

enum RsvpQuestionType {
  TEXT
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum BroadcastAudience {
  ALL
  GOING
  MAYBE
  APPROVED
  PENDING
  WAITLISTED
}
